
<!DOCTYPE html>
<html>
<head>
    <title>Find API Users</title>
</head>
<body>

    <h1>Search Users</h1>

    <input type="text" id="nameInput" placeholder="Enter username">
    <button id="findBtn">Find User</button>

    <p id="result"></p>

    <script>
        let users = [];

        // First, fetch users from the API
        async function getUsers() {
            try {
                const response = await fetch(
                    "https://jsonplaceholder.typicode.com/users"
                );

                if (!response.ok) {
                    throw new Error("Failed to fetch users");
                }

                users = await response.json();

                console.log("Users loaded:", users);

            } catch (error) {
                console.error(error);
            }
        }

        // Then, search for a user
        function findUser() {
            const name = document.getElementById("nameInput").value.trim();

            const selectedUser = users.find(function(user) {
                return user.name.toLowerCase().includes(name.toLowerCase());
            });

            const result = document.getElementById("result");

            if (selectedUser) {
                result.textContent =
                    selectedUser.name + " - " + selectedUser.email;
            } else {
                result.textContent = "User not found";
            }
        }

        document.getElementById("findBtn").addEventListener("click", findUser);

        // Load users when the page opens
        getUsers();
    </script>

</body>
</html>
