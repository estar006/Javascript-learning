<!DOCTYPE html>
<html>
    <body>



        <script>
            const students = [
                {name: "Esther", course: "ICT"},
                {name: "john", course: "Networking"},
                {name: "Mary", course: "web development"}
            ];
            const savedStudents = JSON.stringify(students);
            localStorage.setItem("students", savedStudents);

            const storedStudents = localStorage.getItem("students");
            const studentsData  = JSON.parse(storedStudents);
            console.log(studentsData);

            studentsData.forEach(function(student){
                console.log(student.name);
            }
        );

        const products = [
            {name: "Laptop", price: 40000},
            {name: "tablet", price: 35000},
            {name: "phone" ,price: 25000}

        ];
        const savedProducts = JSON.stringify(products);
        localStorage.setItem("products", savedProducts);
            
        const storedProducts = localStorage.getItem("products");
        const productsData = JSON.parse(storedProducts);
        console.log(productsData);
        productsData.forEach(function(product){
            console.log(product.name + " - ksh " + product.price);
        });



        const employees = [
            {name: "Esther", age: 26, department:"IT"},
             {name: "Mary", age: 22, department: "Finance"},
             {name: "Anne", age:25, department: "HR"}
        ];
            const savedEmployees = JSON.stringify(employees);
            localStorage.setItem("employees",savedEmployees); 

            const storedEmployees = localStorage.getItem("employees");
             const employeesData = JSON.parse(storedEmployees);
             console.log(employeesData);  
             employeesData.forEach(function(employee){
                console.log(employee.name + " - " + employee.age + " - " + employee.department)
             }) ;    
        </script>
    </body>
</html>
