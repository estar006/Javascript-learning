<!DOCTYPE html>
<html>



<body>
<h1>Users API</h1>
<input type="text" id="cityInput" placeholder="Enter city">
<button id="searchBtn">Search</button>
<ul id="userList"></ul>
    <script>

async function getUsers (
) {
    try {
    const response = await fetch("https://jsonplaceholder.typicode.com/users");

    if (!response.ok) {
        throw new Error("Something went wrong");
    }
    const data = await response.json();
    const cityUsers = data.filter(function(user){
     return user.address.city === "South Christy";
    });

    cityUsers.forEach(function(user){
        console.log(user.name);
    });

} catch (error) {
    console.error(error);
}
}
getUsers();


let users = [];
async function getUsers (
) {
    try {
    const response = await fetch("https://jsonplaceholder.typicode.com/users");

    if (!response.ok) {
        throw new Error("Failed to fetch users");
    }
   users = await response.json();

} catch (error) {
    console.error(error);
}
}

function searchUsers (){
    const city = document.getElementById("cityInput").value;
    const filteredUsers = users.filter(function(user){
        return user.address.city.toLowerCase() === city.toLowerCase();
    });
    const userList = document.getElementById("userList");
    userList.innerHTML = "";
    filteredUsers.forEach(function(user){
        const li = document.createElement("li");
        li.textContent = user.name + " - " + user.address.city;
        userList.appendChild(li);
            });
}
document.getElementById("searchBtn").addEventListener("click",searchUsers);
getUsers();


    </script>

    
</body>
</html>
